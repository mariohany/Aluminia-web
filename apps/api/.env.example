NODE_ENV=development
PORT=3000

# Shared control-plane database (users, companies, billing).
DATABASE_URL=postgresql://aluminia:aluminia@localhost:5432/aluminia

REDIS_URL=redis://localhost:6379

# Origin of apps/web, for CORS.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Bar optimiser PDF prints at once (docs/report_queue_planing.md; the solve
# runs in the browser). Optional: unset = CPU count - 1 (at least 1).
# REPORT_MAX_CONCURRENT=1

# Where uploaded files (logos) are stored: postgres (default). s3 comes with DO Spaces.
# FILE_STORAGE=postgres
