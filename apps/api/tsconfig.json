{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "incremental": true,
    "skipLibCheck": true,
    // TypeScript 6 turns `strict` on and empties `types` by default;
    // both are set here so the API compiles as it did on 5.x. Turning
    // on full strict mode is its own change (entities alone need ~100
    // definite-assignment fixes).
    "strict": false,
    "types": ["node", "jest", "multer"],
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "ts-node": {
    // Without this, ts-node only compiles files reachable through
    // imports — which skips standalone .d.ts files like
    // src/types/express.d.ts, so the seed/migration scripts fail to
    // typecheck on `request.user` even though `nest build` is fine.
    "files": true
  }
}
